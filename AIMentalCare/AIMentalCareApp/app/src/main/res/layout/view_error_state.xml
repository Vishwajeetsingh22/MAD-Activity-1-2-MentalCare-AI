<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutErrorState"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_2xl">

    <TextView
        android:id="@+id/txtErrorStateIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/txtErrorStateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="Something went wrong"
        android:textAppearance="@style/TextAppearance.MentalCare.Title"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/txtErrorStateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="Unable to load wellness data. Please try again."
        android:textAppearance="@style/TextAppearance.MentalCare.Caption"
        android:textAlignment="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnErrorStateRetry"
        style="@style/Widget.MentalCare.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="Try Again" />

</LinearLayout>
