<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnJournalBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/primary_green"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Journal"
                    android:textColor="@color/dark_green"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A calm space to reflect on your thoughts"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ======================================================== -->
        <!-- CALM WRITING CANVAS CARD                                  -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How are you feeling today?"
                    android:textColor="@color/main_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Take a mindful breath and express whatever is on your mind."
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />

                <!-- Multiline Calm Writing Field -->
                <EditText
                    android:id="@+id/etJournalInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_medical_card"
                    android:gravity="top|start"
                    android:hint="Write your thoughts..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:textColor="@color/main_text"
                    android:textColorHint="@color/secondary_text"
                    android:textSize="14sp" />

                <!-- Mood Selector Row (😊 🙂 😐 😟 😣) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Select Mood"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupMood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMoodGreat"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="😊 Great"
                            android:textColor="@color/main_text"
                            android:textSize="13sp"
                            android:checked="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMoodGood"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="🙂 Good"
                            android:textColor="@color/main_text"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMoodNeutral"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="😐 Okay"
                            android:textColor="@color/main_text"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMoodLow"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="😟 Low"
                            android:textColor="@color/main_text"
                            android:textSize="13sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipMoodDifficult"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="😣 Difficult"
                            android:textColor="@color/main_text"
                            android:textSize="13sp" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Save Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveJournalDirect"
                    style="@style/Widget.MentalCare.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="Save Entry ✨"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================== -->
        <!-- PAST ENTRIES SECTION                                      -->
        <!-- ======================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📖 Past Reflections"
                android:textColor="@color/main_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtJournalCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_medical_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="0 entries"
                android:textColor="@color/secondary_text"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Search / Filter Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Search journal entries..."
            app:boxStrokeColor="@color/primary_green"
            app:boxBackgroundColor="@color/card_background"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/primary_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchJournal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/main_text"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutJournalEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_medical_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍃"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No Journal Entries Yet"
                android:textColor="@color/main_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Take a gentle pause and write your first thoughts in the canvas above."
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Entries RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerJournals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
