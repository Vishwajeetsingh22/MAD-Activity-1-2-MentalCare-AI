<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Top Screen Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Wellness Insights"
            android:textColor="@color/dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Real-time patterns derived from your verified check-in data."
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <!-- ======================================================== -->
        <!-- 1. CURRENT STRESS STATUS CARD                             -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Stress Status"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCurrentStressTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="No data yet"
                        android:textColor="@color/secondary_text"
                        android:textSize="11sp" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/txtCurrentStressStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No Check-ins Yet"
                        android:textColor="@color/main_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCurrentStressScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_medical_card"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="-- %"
                        android:textColor="@color/primary_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtCurrentMoodSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Complete a wellness check-in to establish your current baseline."
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================== -->
        <!-- 3. STRESS TREND (REAL CANVAS CHART)                       -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈 Recent Pattern"
                        android:textColor="@color/main_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt7DayAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="7-Day Avg: --"
                        android:textColor="@color/dark_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Custom Canvas Chart View -->
                <com.aimentalcare.app.ui.StressChartView
                    android:id="@+id/stressChartView"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="12dp" />

                <!-- Burnout Progression List (Day 1 -> Day 7) -->
                <TextView
                    android:id="@+id/txtBurnoutProgression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_medical_card"
                    android:padding="10dp"
                    android:text="Complete a few wellness check-ins to see your personal trends."
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================== -->
        <!-- 4. DAILY CHECK-IN COMPLETION PROGRESS                     -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check-in Progress"
                        android:textColor="@color/main_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCheckInProgressFraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0 of 7 days"
                        android:textColor="@color/primary_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Linear Progress Bar (0 to 7 days) -->
                <ProgressBar
                    android:id="@+id/progressCheckInWeekly"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:max="7"
                    android:progress="0"
                    android:progressTint="@color/primary_green"
                    android:progressBackgroundTint="@color/divider_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtStreakDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 0 Days"
                        android:textColor="@color/color_moderate"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtWeeklyConsistency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="• Keep checking in daily to maintain your streak"
                        android:textColor="@color/secondary_text"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================== -->
        <!-- 6. PERSONALISED INSIGHTS CARD                             -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Your Insights"
                    android:textColor="@color/main_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPersonalizedInsight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Complete a few wellness check-ins to see your personal trends."
                    android:textColor="@color/main_text"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:id="@+id/layoutPatternDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtSleepPatternInsight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Sleep Recovery: Stable rest"
                        android:textColor="@color/secondary_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtEnergyPatternInsight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="• Energy: Balanced baseline"
                        android:textColor="@color/secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================== -->
        <!-- 5. WELLNESS PROGRESS & BURNOUT RISK CARD                  -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wellness Progress &amp; Burnout Risk"
                        android:textColor="@color/main_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtBurnoutBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_medical_card"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="MONITORING"
                        android:textColor="@color/primary_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Metric counters: Checkins, Journals -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_medical_card"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/txtTotalCheckIns"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/dark_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Check-ins"
                            android:textColor="@color/secondary_text"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_medical_card"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/txtTotalJournals"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/ai_purple"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Journals Saved"
                            android:textColor="@color/secondary_text"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtBurnoutMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_medical_card"
                    android:padding="10dp"
                    android:text="Complete at least 3 daily check-ins to run the multi-day burnout risk scan."
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecalculateBurnout"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="🔄 Run Burnout Risk Scan"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_green"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================== -->
        <!-- 7. RECOMMENDED WELLNESS ACTIVITIES CARD                   -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿 Recommended Wellness Activities"
                    android:textColor="@color/main_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tailored suggestions based on your current stress status."
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp" />

                <!-- Dynamic Activities Container -->
                <LinearLayout
                    android:id="@+id/layoutRecommendedActivities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ======================================================== -->
        <!-- 2. RECENT STRESS HISTORY CARD                             -->
        <!-- ======================================================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📜 Recent Stress History"
                    android:textColor="@color/main_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Unique daily records and reflection logs"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp" />

                <!-- Dynamic History List -->
                <LinearLayout
                    android:id="@+id/layoutHistoryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_medical_card"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="No check-ins logged yet. Complete a check-in to see your history."
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
