<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_mint"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🆘 SOS Emergency Settings"
            android:textColor="@color/dark_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Configure and manage your primary emergency distress hotline number."
            android:textColor="@color/text_subtle"
            android:textSize="13sp" />

        <!-- Current SOS Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_medical_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE EMERGENCY SOS NUMBER"
                android:textColor="@color/text_subtle"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCurrentSosNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="+91 98888 00000"
                android:textColor="@color/alert_banner_red"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="This number is dialed when triggering emergency SOS assistance."
                android:textColor="@color/text_subtle"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Change Number Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_medical_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✏️ Change SOS Number"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Enter valid 10-digit mobile number or emergency contact."
                android:textColor="@color/text_subtle"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNewSosNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_medical_card"
                android:hint="Enter phone number (e.g. +91 98765 43210)"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_subtle"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSaveSosNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary_green"
                android:text="💾 Save SOS Number"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Test Emergency Call Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_medical_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 Emergency Action Test"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Safe Dialing Protocol: A confirmation prompt will always ask for verification before launching the phone dialer."
                android:textColor="@color/text_subtle"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTestSosCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/alert_banner_red"
                android:text="🚨 Call SOS Contact"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
