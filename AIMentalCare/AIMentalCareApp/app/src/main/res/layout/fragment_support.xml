<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_mint"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Screen Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🆘 Crisis &amp; Safety Support"
            android:textColor="@color/alert_banner_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Immediate resources, trusted contacts, and emergency assistance."
            android:textColor="@color/text_subtle"
            android:textSize="13sp" />

        <!-- Helpline Action Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_medical_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Helplines"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Primary SOS Call Button -->
            <Button
                android:id="@+id/btnCallSosNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/alert_banner_red"
                android:text="🚨 Call Emergency SOS Contact"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnManageContactsFromSupport"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/light_mint"
                android:text="👥 Manage Emergency Contacts"
                android:textColor="@color/dark_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCallHotline"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/ai_purple"
                android:text="📞 Call National Crisis Hotline (988 / 112)"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Guided Breathing Exercise Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_medical_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧘 5-Minute Guided Box Breathing"
                android:textColor="@color/primary_teal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtBreathingPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Inhale Deeply (4s)..."
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtBreathingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="05:00"
                android:textColor="@color/primary_teal"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStartBreathing"
                android:layout_width="200dp"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_green"
                android:text="Start Breathing"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Minimal Footnote Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="If you or someone you know is in immediate danger, please call your local emergency services (911 / 112 / 988) or go to the nearest emergency room."
            android:textColor="@color/text_subtle"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
