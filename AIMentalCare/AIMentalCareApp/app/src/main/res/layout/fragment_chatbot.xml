<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background"
    android:orientation="vertical">

    <!-- Top Chat Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnChatBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toStartOf="@+id/layoutChatActions"
                android:layout_toEndOf="@id/btnChatBack"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Wellness Companion ✦"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Your supportive conversation companion"
                    android:textColor="#D1FAE5"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutChatActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewChat"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:text="+ New"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChatHistory"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:text="History"
                    android:textColor="#E9D5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearChat"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="8dp"
                    android:text="Clear"
                    android:textColor="#D1FAE5"
                    android:textSize="11sp" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Dynamic Stress Context Chip -->
        <TextView
            android:id="@+id/txtChatStressContext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ai_glass_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="🌿 Context: Normal wellness baseline"
            android:textColor="@color/main_text"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Chat Messages Feed -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="12dp" />

    <!-- AI Thinking Loading Indicator -->
    <LinearLayout
        android:id="@+id/layoutAiThinking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/ai_purple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="AI is thinking..."
            android:textColor="@color/ai_purple"
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>

    <!-- Quick Prompt Suggestions Horizontal Bar (5 Prompts) -->
    <HorizontalScrollView
        android:id="@+id/scrollQuickPrompts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipRelax"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="14dp"
                android:text="🧘 Help me relax"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/primary_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipStressed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="14dp"
                android:text="😟 I'm feeling stressed"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/primary_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipPlanDay"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="14dp"
                android:text="📋 Help me plan my day"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/primary_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipSleep"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="14dp"
                android:text="🌙 Improve my sleep"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/primary_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipRecentCheckIns"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingHorizontal="14dp"
                android:text="📊 Tell me about my recent check-ins"
                android:textColor="@color/ai_purple"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/ai_purple" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Non-Diagnostic Safety Disclaimer Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="ℹ️ AI responses provide supportive wellness guidance and do not diagnose medical conditions."
        android:textAppearance="@style/TextAppearance.MentalCare.Caption"
        android:textSize="10sp" />

    <!-- Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_premium"
            android:hint="Type a message..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/main_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendMessage"
            style="@style/Widget.MentalCare.Button.Primary"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            app:backgroundTint="@color/ai_purple"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white" />

    </LinearLayout>

</LinearLayout>