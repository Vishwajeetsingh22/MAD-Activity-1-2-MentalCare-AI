<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_mint"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- 1. TIME-SPECIFIC DYNAMIC GREETING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xs">

            <TextView
                android:id="@+id/txtGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good morning, Friend 👋"
                android:textColor="@color/main_text"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtGreetingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Start your day with a quick wellness check-in."
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/text_size_body" />
        </LinearLayout>

        <!-- In-App Gentle Check-In Prompt Banner (Context-Aware / Dismissible) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInAppCheckInPrompt"
            style="@style/Widget.MentalCare.Card.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:visibility="gone"
            app:cardBackgroundColor="@color/light_mint"
            app:strokeColor="@color/primary_green"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="Ready for your daily check-in?"
                        android:textColor="@color/dark_green"
                        android:textSize="@dimen/text_size_title_small"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnDismissPrompt"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Dismiss"
                        android:src="@drawable/ic_close"
                        app:tint="@color/primary_green" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Take 2 minutes to reflect on your stress, sleep, and emotional wellness today."
                    android:textColor="@color/main_text"
                    android:textSize="@dimen/text_size_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPromptStartCheckIn"
                        style="@style/Widget.MentalCare.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Start check-in"
                        android:textSize="@dimen/text_size_caption" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPromptNotNow"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="Not now"
                        android:textColor="@color/secondary_text"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. TODAY'S WELLNESS SUMMARY CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWellnessSummary"
            style="@style/Widget.MentalCare.Card.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Wellness"
                    android:textAppearance="@style/TextAppearance.MentalCare.Label" />

                <!-- 3 Columns Metric Overview (Stress, Sleep, Progress) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Stress Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stress"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:id="@+id/txtSummaryStress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="--"
                            android:textColor="@color/primary_green"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSummaryStressScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No data"
                            android:textColor="@color/secondary_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/divider_color" />

                    <!-- Sleep Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sleep"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:id="@+id/txtSummarySleep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="--"
                            android:textColor="@color/main_text"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSummarySleepLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Rest recovery"
                            android:textColor="@color/secondary_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/divider_color" />

                    <!-- Plan Progress Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Progress"
                            android:textColor="@color/secondary_text"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:id="@+id/txtSummaryProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0%"
                            android:textColor="@color/dark_green"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSummaryPlanTasks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0/5 tasks"
                            android:textColor="@color/secondary_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. DAILY CHECK-IN CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDailyCheckIn"
            style="@style/Widget.MentalCare.Card.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/txtCheckInIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCheckInTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How are you feeling today?"
                        android:textAppearance="@style/TextAppearance.MentalCare.TitleSmall" />

                    <TextView
                        android:id="@+id/txtCheckInSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Take a moment to understand how you're feeling."
                        android:textAppearance="@style/TextAppearance.MentalCare.Caption" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartCheckIn"
                    style="@style/Widget.MentalCare.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Start"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Mood Selector -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MentalCare.Card.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Mood Check"
                    android:textAppearance="@style/TextAppearance.MentalCare.Label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMoodGreat"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="😊 Great"
                        android:textColor="@color/main_text"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/card_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMoodGood"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="🙂 Good"
                        android:textColor="@color/main_text"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/card_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMoodOkay"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="😐 Okay"
                        android:textColor="@color/main_text"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/card_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMoodStressed"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="😟 Stress"
                        android:textColor="@color/main_text"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/card_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMoodLow"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:padding="0dp"
                        android:text="😔 Low"
                        android:textColor="@color/main_text"
                        android:textSize="11sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/card_border" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. TODAY'S INSIGHT / STRESS TREND CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStressTrend"
            style="@style/Widget.MentalCare.Card.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 Stress Trend"
                            android:textAppearance="@style/TextAppearance.MentalCare.TitleSmall" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Your recent wellness pattern"
                            android:textAppearance="@style/TextAppearance.MentalCare.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDashboardStressBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_medical_card"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="NORMAL"
                        android:textColor="@color/primary_green"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Trend Content (Shown when real check-ins exist) -->
                <LinearLayout
                    android:id="@+id/layoutTrendContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtDashboardStressScore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Stress: Normal baseline"
                            android:textColor="@color/main_text"
                            android:textSize="@dimen/text_size_body" />

                        <TextView
                            android:id="@+id/txtDashboardTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trend: Baseline"
                            android:textColor="@color/primary_green"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewInsights"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:padding="0dp"
                        android:text="View Full Insights &amp; Trends →"
                        android:textColor="@color/primary_green"
                        android:textSize="@dimen/text_size_caption" />
                </LinearLayout>

                <!-- Professional Empty State (Shown when insufficient data) -->
                <LinearLayout
                    android:id="@+id/layoutTrendEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/spacing_md"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌱"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="No trend history yet"
                        android:textAppearance="@style/TextAppearance.MentalCare.TitleSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Complete daily check-ins to view your multi-day wellness pattern."
                        android:textAppearance="@style/TextAppearance.MentalCare.Caption"
                        android:textAlignment="center" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. NEXT SCHEDULED REMINDER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReminderStatus"
            style="@style/Widget.MentalCare.Card.Premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/txtNextReminderNotice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:text="Daily Reminder: Scheduled"
                    android:textAppearance="@style/TextAppearance.MentalCare.Caption" />

                <TextView
                    android:id="@+id/btnAdjustReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_xs"
                    android:text="Settings"
                    android:textColor="@color/primary_green"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Medical Disclaimer Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:text="ℹ️ AI responses and stress estimates are provided for general wellness support and are not medical diagnoses."
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.MentalCare.Caption" />

    </LinearLayout>
</ScrollView>