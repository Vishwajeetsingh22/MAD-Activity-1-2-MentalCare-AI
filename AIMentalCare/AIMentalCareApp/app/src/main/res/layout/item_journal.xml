<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Mood Badge & Date/Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtJournalMood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿 Calm"
                android:textColor="@color/dark_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_medical_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/txtJournalDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Sep 29, 2026 • 10:15 AM"
                android:textColor="@color/text_subtle"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnEditJournal"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                app:tint="@color/text_subtle"
                android:contentDescription="Edit" />

            <ImageButton
                android:id="@+id/btnDeleteJournal"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/color_high"
                android:contentDescription="Delete" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/txtJournalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Morning Reflection"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Content -->
        <TextView
            android:id="@+id/txtJournalContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Wrote down my thoughts about the upcoming week. Feeling ready to tackle assignments..."
            android:textColor="@color/text_subtle"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- AI Analysis Result Strip (if analyzed) -->
        <LinearLayout
            android:id="@+id/layoutAiBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_medical_card"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtAiStressLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 AI Analysis: LOW STRESS"
                android:textColor="@color/primary_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAiRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Recommendation: Keep up your mindful routine."
                android:textColor="@color/text_subtle"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Analyze with AI Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyzeWithAi"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:text="✨ Analyze with AI"
            android:textColor="@color/ai_purple"
            android:textSize="12sp"
            android:paddingHorizontal="14dp"
            app:strokeColor="@color/ai_purple"
            app:cornerRadius="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
