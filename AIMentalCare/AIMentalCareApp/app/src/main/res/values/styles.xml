<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===================================================== -->
    <!-- MENTALCARE AI DESIGN SYSTEM STYLES & TYPOGRAPHY       -->
    <!-- ===================================================== -->

    <!-- Typography Hierarchy -->
    <style name="TextAppearance.MentalCare.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/main_text</item>
    </style>

    <style name="TextAppearance.MentalCare.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/main_text</item>
    </style>

    <style name="TextAppearance.MentalCare.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_size_title_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/main_text</item>
    </style>

    <style name="TextAppearance.MentalCare.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <style name="TextAppearance.MentalCare.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/main_text</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.MentalCare.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/secondary_text</item>
    </style>

    <style name="TextAppearance.MentalCare.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/primary_green</item>
    </style>

    <!-- Component Styles: Premium Card (20-24px rounded corners) -->
    <style name="Widget.MentalCare.Card.Premium" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <!-- Component Styles: Primary Button -->
    <style name="Widget.MentalCare.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">@dimen/elevation_low</item>
    </style>

    <!-- Component Styles: Secondary Button -->
    <style name="Widget.MentalCare.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textColor">@color/dark_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Component Styles: Input Fields -->
    <style name="Widget.MentalCare.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_green</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="hintTextColor">@color/primary_green</item>
    </style>

</resources>
